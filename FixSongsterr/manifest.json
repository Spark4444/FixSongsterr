{
  "manifest_version": 3,
  "name": "FixSongsterr",
  "description": "Extension that fixes the mobile-like layout on songsterr",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": ["*://*.songsterr.com/*", "*://songsterr.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": ["*://*.songsterr.com/*"]
}
