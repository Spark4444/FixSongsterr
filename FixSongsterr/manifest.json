{
  "manifest_version": 3,
  "name": "FixSongsterr",
  "description": "Extension that fixes the mobile-like layout on songsterr",
  "version": "1.5.0",
  "content_scripts": [
    {
      "matches": ["*://*.songsterr.com/*", "*://songsterr.com/*"],
      "js": [
        "js/css.js",
        "js/inject.js",
        "js/adjustableStyles/bottomPopups/initialize.js",
        "js/adjustableStyles/bottomPopups/top.js",
        "js/adjustableStyles/bottomPopups/left.js",
        "js/adjustableStyles/bottomPopups/listeners.js",
        "js/adjustableStyles/topPopup.js",
        "js/removeAds.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": ["*://*.songsterr.com/*"],
  "icons": {
    "128": "img/128.png",
    "96": "img/96.png",
    "64": "img/64.png",
    "48": "img/48.png",
    "32": "img/32.png",
    "16": "img/16.png"
  }
}